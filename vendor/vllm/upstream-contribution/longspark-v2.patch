+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+
+from transformers import PreTrainedConfig
+
+
+class LongSparkConfig(PreTrainedConfig):
+    """Inference configuration for Global16/Raw256/Local7 checkpoints."""
+
+    model_type = "draftfreekv"
+    has_no_defaults_at_init = True
+
+    def __init__(
+        self,
+        target_layer_ids: list[int] | None = None,
+        hidden_size: int = 4096,
+        vocab_size: int = 32000,
+        num_key_value_heads: int = 32,
+        head_dim: int = 128,
+        qwen_num_attention_heads: int | None = None,
+        qwen_intermediate_size: int | None = None,
+        qwen_rope_theta: float = 1_000_000.0,
+        qwen_rms_norm_eps: float = 1e-6,
+        block_size: int = 7,
+        draft_mode: str = "parallel_shifted_qwen",
+        global16_raw256_enabled: bool = True,
+        parallel_mixer_layers: int | None = None,
+        parallel_markov_rank: int = 0,
+        parallel_markov_head_type: str = "vanilla",
+        mask_token_id: int | None = None,
+        global_memory_slots: int = 16,
+        raw_target_rows: int = 256,
+        local_draft_rows: int = 7,
+        max_accepted_tokens: int = 8,
+        global_query_mode: str = "learned",
+        global_query_equicorrelation: float = 0.4,
+        global_query_slot_mass_mode: str = "system",
+        **kwargs,
+    ) -> None:
+        # Existing checkpoints use DraftFreeKVModel and training-only metadata.
+        kwargs.pop("architectures", None)
+        super().__init__(architectures=["LongSparkDraftModel"], **kwargs)
+        self.target_layer_ids = list(target_layer_ids or [])
+        self.hidden_size = hidden_size
+        self.vocab_size = vocab_size
+        self.num_key_value_heads = num_key_value_heads
+        self.head_dim = head_dim
+        self.qwen_num_attention_heads = (
+            qwen_num_attention_heads or hidden_size // head_dim
+        )
+        self.qwen_intermediate_size = qwen_intermediate_size or hidden_size * 4
+        self.qwen_rope_theta = qwen_rope_theta
+        self.qwen_rms_norm_eps = qwen_rms_norm_eps
+        self.block_size = block_size
+        self.draft_mode = draft_mode
+        self.global16_raw256_enabled = global16_raw256_enabled
+        self.parallel_mixer_layers = (
+            len(self.target_layer_ids)
+            if parallel_mixer_layers is None
+            else parallel_mixer_layers
+        )
+        self.parallel_markov_rank = parallel_markov_rank
+        self.parallel_markov_head_type = parallel_markov_head_type
+        self.mask_token_id = mask_token_id
+        self.global_memory_slots = global_memory_slots
+        self.raw_target_rows = raw_target_rows
+        self.local_draft_rows = local_draft_rows
+        self.max_accepted_tokens = max_accepted_tokens
+        self.global_query_mode = global_query_mode
+        self.global_query_equicorrelation = global_query_equicorrelation
+        self.global_query_slot_mass_mode = global_query_slot_mass_mode
+        self.num_attention_heads = self.qwen_num_attention_heads
+        self.num_hidden_layers = self.parallel_mixer_layers
+        self.intermediate_size = self.qwen_intermediate_size
+        self.rope_theta = qwen_rope_theta
+        self.rope_parameters = {"rope_type": "default", "rope_theta": qwen_rope_theta}
