+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+
+from types import SimpleNamespace
+from unittest.mock import MagicMock, patch
+
+import pytest
+import torch
+from transformers import Qwen3Config
+
+from vllm.config import ParallelConfig, SpeculativeConfig
+from vllm.config.longspark import validate_longspark_config
+from vllm.transformers_utils.config import get_config
+from vllm.transformers_utils.configs.longspark import LongSparkConfig
+from vllm.v1.attention.backends.registry import AttentionBackendEnum
+
+pytestmark = pytest.mark.cpu_test
+
+
+def _draft_config(**kwargs):
+    fields = dict(
+        target_layer_ids=[0, 2],
+        hidden_size=64,
+        vocab_size=128,
+        num_key_value_heads=2,
+        head_dim=16,
+        qwen_num_attention_heads=4,
+        qwen_intermediate_size=128,
+        mask_token_id=0,
+    )
+    fields.update(kwargs)
+    return LongSparkConfig(**fields)
+
+
+def _speculative_config(draft_kwargs=None, **kwargs):
+    target_hf = Qwen3Config(
+        hidden_size=64,
+        vocab_size=128,
+        num_hidden_layers=3,
+        num_attention_heads=4,
+        num_key_value_heads=2,
+        head_dim=16,
+        intermediate_size=128,
+        rope_theta=1_000_000.0,
+    )
+    target = MagicMock(
+        hf_config=target_hf,
+        hf_text_config=target_hf,
+        max_model_len=128,
+        quantization=None,
+        hf_overrides={},
+    )
+    hf_config = _draft_config(**(draft_kwargs or {}))
+    draft = MagicMock(
+        hf_config=hf_config,
+        architectures=hf_config.architectures,
+        max_model_len=128,
+    )
+    with patch("vllm.config.speculative.ModelConfig", return_value=draft):
+        return SpeculativeConfig(
+            model="draft",
+            method="longspark",
+            target_model_config=target,
+            target_parallel_config=ParallelConfig(),
+            **kwargs,
+        )
+
+
+def test_legacy_checkpoint_config_loads_without_remote_code(tmp_path):
+    draft = _draft_config()
+    draft.architectures = ["DraftFreeKVModel"]
+    draft.save_pretrained(tmp_path)
+    loaded = get_config(str(tmp_path), trust_remote_code=False)
+    assert isinstance(loaded, LongSparkConfig)
+    assert loaded.target_layer_ids == [0, 2]
+    assert loaded.architectures == ["LongSparkDraftModel"]
+
+
+def test_longspark_uses_anchor_first_scheduling_and_target_aux_layers():
+    config = _speculative_config()
+    assert config.num_speculative_tokens == 7
+    assert config.parallel_drafting
+    assert config.use_eagle()
+    assert config.max_num_new_slots_for_drafting == 6
+    assert config.draft_model_config.hf_config.eagle_aux_hidden_state_layer_ids == [1]
+
+
+@pytest.mark.parametrize(
+    "kwargs",
+    [
+        {"num_speculative_tokens": 8},
+        {"draft_sample_method": "probabilistic"},
+        {"rejection_sample_method": "block"},
+        {"enable_adaptive_verification": True},
+        {"num_speculative_tokens_per_batch_size": [(1, 4, 3)]},
+        {"use_local_argmax_reduction": True},
+        {"disable_padded_drafter_batch": True},
+    ],
+)
+def test_longspark_rejects_unsupported_drafting_modes(kwargs):
+    with pytest.raises(ValueError, match="LongSpark"):
+        _speculative_config(**kwargs)
+
+
+@pytest.mark.parametrize(
+    "kwargs",
+    [
+        {"target_layer_ids": [2]},
+        {"target_layer_ids": [2, 0]},
+        {"target_layer_ids": [0, 3]},
+        {"global16_raw256_enabled": False},
+        {"raw_target_rows": 128},
+        {"hidden_size": 32},
+        {"qwen_rope_theta": 10000},
+    ],
+)
+def test_longspark_rejects_incompatible_checkpoint_geometry(kwargs):
+    with pytest.raises(ValueError, match="LongSpark"):
+        _speculative_config(draft_kwargs=kwargs)
+
+
+def _serving_config():
+    return SimpleNamespace(
+        use_v2_model_runner=True,
+        model_config=SimpleNamespace(
+            dtype=torch.bfloat16,
+            quantization=None,
+            logits_processors=None,
+            model_impl="auto",
+            runner_type="generate",
+            architectures=["Qwen3ForCausalLM"],
+        ),
+        parallel_config=ParallelConfig(),
+        cache_config=SimpleNamespace(enable_prefix_caching=False, cache_dtype="auto"),
+        attention_config=SimpleNamespace(backend=None),
+        lora_config=None,
+        kv_transfer_config=None,
+        watermark_config=None,
+    )
+
+
+def test_longspark_selects_compatible_target_kv_layout():
+    config = _serving_config()
+    with patch("vllm.platforms.current_platform.is_cuda", return_value=True):
+        validate_longspark_config(config)
+    assert config.attention_config.backend == AttentionBackendEnum.FLASH_ATTN
+
+
+@pytest.mark.parametrize(
+    "section,field,value",
+    [
+        (None, "use_v2_model_runner", False),
+        (None, "lora_config", object()),
+        (None, "kv_transfer_config", object()),
+        ("model_config", "dtype", torch.float16),
+        ("model_config", "quantization", "fp8"),
+        ("model_config", "model_impl", "transformers"),
+        ("model_config", "runner_type", "pooling"),
+        ("cache_config", "enable_prefix_caching", True),
+        ("cache_config", "cache_dtype", "fp8"),
+        ("parallel_config", "tensor_parallel_size", 2),
+        ("parallel_config", "prefill_context_parallel_size", 2),
+        ("attention_config", "backend", AttentionBackendEnum.TRITON_ATTN),
+    ],
+)
+def test_longspark_rejects_unsupported_serving_modes(section, field, value):
+    config = _serving_config()
+    setattr(getattr(config, section) if section else config, field, value)
+    with (
+        patch("vllm.platforms.current_platform.is_cuda", return_value=True),
+        pytest.raises(ValueError, match="LongSpark"),
+    ):
+        validate_longspark_config(config)
