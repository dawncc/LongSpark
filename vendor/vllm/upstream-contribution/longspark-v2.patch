+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Accepted-prefix state contracts, independent of a target checkpoint."""
+
+import copy
+from types import SimpleNamespace
+
+import pytest
+import torch
+from torch import nn
+
+from vllm.platforms import current_platform
+from vllm.v1.worker.gpu.spec_decode.longspark.state import LongSparkState
+
+from .test_longspark_model import make_model
+
+
+@pytest.fixture(params=["cpu", "cuda"])
+def state(request):
+    if request.param == "cuda" and not current_platform.is_cuda():
+        pytest.skip("CUDA store and graph tests require NVIDIA GPUs")
+    device = torch.device("cuda:0" if request.param == "cuda" else "cpu")
+    draft_model = make_model()
+    draft_model.load_weights(
+        (name, torch.randn_like(weight))
+        for name, weight in draft_model.named_parameters()
+    )
+    draft_model.to(device=device, dtype=torch.bfloat16)
+    target = SimpleNamespace(
+        model=SimpleNamespace(
+            embed_tokens=nn.Embedding(32, 16, device=device, dtype=torch.bfloat16),
+            norm=nn.RMSNorm(16, device=device, dtype=torch.bfloat16),
+        ),
+        lm_head=nn.Linear(16, 32, bias=False, device=device, dtype=torch.bfloat16),
+    )
+    hf_config = SimpleNamespace(
+        model_type="qwen3",
+        hidden_size=16,
+        vocab_size=32,
+        num_key_value_heads=1,
+        num_attention_heads=2,
+        head_dim=8,
+        num_hidden_layers=3,
+        rms_norm_eps=1e-6,
+        rope_theta=1_000_000.0,
+    )
+    return LongSparkState(draft_model, target, hf_config, 4, device)
+
+
+def rows(state, width):
+    keys = torch.randn(2, 2, width, 1, 8, dtype=torch.bfloat16, device=state.device)
+    values = torch.randn_like(keys)
+    hidden = torch.randn(2, width, 2, 16, dtype=torch.bfloat16, device=state.device)
+    return keys, values, hidden
+
+
+def assert_bitwise(left, right):
+    for expected, actual in zip(left.mutable_state(), right.mutable_state()):
+        assert torch.equal(expected.view(torch.uint8), actual.view(torch.uint8))
+
+
+def test_only_accepted_rows_enter_recent_memory_and_zero_count_is_inert(state):
+    keys, values, hidden = rows(state, 300)
+    slots = torch.tensor([2, 0], device=state.device)
+    starts = torch.zeros(2, dtype=torch.long, device=state.device)
+    counts = torch.tensor([300, 0], device=state.device)
+    for tensor in (keys, values, hidden):
+        tensor[1].fill_(float("nan"))
+    state.update(slots, keys, values, hidden, starts, counts)
+    positions = torch.arange(44, 300, device=state.device)
+    torch.testing.assert_close(
+        state.keys[2, :, positions % 256], keys[0, :, positions], rtol=0, atol=0
+    )
+    torch.testing.assert_close(state.hidden[2], hidden[0, 299], rtol=0, atol=0)
+    assert state.lengths.tolist() == [0, 0, 300, 0, 0]
+    assert torch.isfinite(state.global_output).all()
+    before = copy.deepcopy(state)
+    counts.zero_()
+    starts.fill_(999)
+    state.update(slots, keys, values, hidden, starts, counts)
+    assert_bitwise(before, state)
+
+
+def test_reused_request_slot_resets_global_summary_and_hidden_boundary(state):
+    keys, values, hidden = rows(state, 8)
+    slots = torch.tensor([2, 0], device=state.device)
+    starts = torch.zeros(2, dtype=torch.long, device=state.device)
+    counts = torch.tensor([8, 7], device=state.device)
+    state.update(slots, keys, values, hidden, starts, counts)
+    fresh = copy.deepcopy(state)
+    fresh.reset()
+    keys, values, hidden = rows(state, 8)
+    counts.copy_(torch.tensor([3, 1], device=state.device))
+    for row, count in enumerate((3, 1)):
+        keys[row, :, count:] = float("nan")
+        values[row, :, count:] = float("nan")
+        hidden[row, count:] = float("nan")
+    for current in (state, fresh):
+        current.update(slots, keys, values, hidden, starts, counts)
+    for name in ("global_output", "global_lse", "hidden", "lengths"):
+        torch.testing.assert_close(
+            getattr(state, name), getattr(fresh, name), rtol=0, atol=0
+        )
+    for row, slot, count in ((0, 2, 3), (1, 0, 1)):
+        torch.testing.assert_close(
+            state.keys[slot, :, :count], keys[row, :, :count], rtol=0, atol=0
+        )
+
+
+@pytest.mark.parametrize("width,boundary", [(8, True), (512, False)])
+def test_fused_commit_graph_handles_dynamic_counts_reordering_and_padding(
+    state, width, boundary
+):
+    if state.device.type != "cuda":
+        pytest.skip("CUDA graph contract")
+    reference = copy.deepcopy(state)
+    reference.use_fused_commit = False
+    keys, values, hidden = rows(state, width)
+    if boundary:
+        hidden = hidden[:, 0].contiguous()
+    slots = torch.tensor([2, 0], device=state.device)
+    starts = torch.zeros(2, dtype=torch.long, device=state.device)
+    counts = torch.tensor([width, 1], device=state.device)
+
+    def update(current):
+        current.update(slots, keys, values, hidden, starts, counts)
+
+    stream = torch.cuda.Stream()
+    stream.wait_stream(torch.cuda.current_stream())
+    with torch.cuda.stream(stream):
+        update(state)
+    torch.cuda.current_stream().wait_stream(stream)
+    graph = torch.cuda.CUDAGraph()
+    with torch.cuda.graph(graph):
+        update(state)
+    update(reference)
+    assert_bitwise(reference, state)
+    for ordering, accepted in (
+        ([0, 2], [3, 0]),
+        ([2, 0], [0, 7]),
+        ([-1, -1], [width, width]),
+    ):
+        slots.copy_(torch.tensor(ordering, device=state.device))
+        starts.copy_(reference.lengths.index_select(0, slots.clamp_min(0)))
+        counts.copy_(torch.tensor(accepted, device=state.device))
+        graph.replay()
+        update(reference)
+        torch.accelerator.synchronize()
+        assert_bitwise(reference, state)
