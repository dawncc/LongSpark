+++ b/vllm/v1/worker/gpu/spec_decode/longspark/speculator.py
@@ -0,0 +1,247 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+# SPDX-FileCopyrightText: Copyright (c) 2026 The LongSpark Authors
+# Adapted from LongSpark. See LICENSE in this directory for the original license.
+"""LongSpark parallel drafting using confirmed target KV and bounded state."""
+
+from typing import Any
+
+import torch
+
+from vllm.config import VllmConfig, replace
+from vllm.config.compilation import CUDAGraphMode
+from vllm.model_executor.model_loader.utils import get_draft_load_config
+from vllm.v1.worker.gpu.cudagraph_utils import CudaGraphManager
+from vllm.v1.worker.gpu.dp_utils import DPSyncState
+from vllm.v1.worker.gpu.input_batch import InputBatch
+from vllm.v1.worker.gpu.spec_decode.speculator import DraftModelSpeculator
+from vllm.v1.worker.gpu.spec_decode.utils import get_pp_safe_draft_load_config
+
+from .gather_kernel import fused_gather_target_context
+from .inputs import gather_target_context
+from .startup import prefill_workspace_budget
+from .state import LongSparkState
+
+
+class LongSparkSpeculator(DraftModelSpeculator):
+    """Anchor-first Local7 proposals with persistent GPU request slots.
+
+    Like DSpark, the draft network and sequential Markov sampling share a full
+    CUDA graph. Only verified target rows enter the Global16/Raw256 state, so
+    rejected suffixes never require rolling back an attention accumulator.
+    """
+
+    num_query_per_req = 7
+
+    def __init__(self, vllm_config: VllmConfig, device: torch.device):
+        super().__init__(vllm_config, device)
+        self.layer_ids = self.draft_model_config.hf_config.target_layer_ids
+        self.hf_config = vllm_config.model_config.hf_config
+        self.target_depth = self.hf_config.num_hidden_layers
+        self.head_dim = vllm_config.model_config.get_head_size()
+        self.aux_layer_ids = [i for i in self.layer_ids if i != self.target_depth - 1]
+        self._graph_manager: CudaGraphManager | None = None
+        # Each padded row has its own slot, avoiding concurrent indexed stores
+        # to a shared sentinel when a captured batch is larger than the input.
+        self._padding_slots = (
+            torch.arange(self.max_num_reqs, device=device, dtype=torch.long)
+            + self.max_num_reqs
+        )
+        self._idx = self._padding_slots.clone()
+        self._anchors = torch.zeros(self.max_num_reqs, dtype=torch.long, device=device)
+        self._starts = torch.ones_like(self._anchors)
+        self._counts = torch.zeros_like(self._anchors)
+        self._token_offsets = torch.arange(
+            self.max_num_tokens, device=device, dtype=torch.long
+        )
+        self._prefill_workspace_bytes = prefill_workspace_budget(
+            max_num_reqs=self.max_num_reqs,
+            max_num_tokens=self.max_num_tokens,
+            max_model_len=self.max_model_len,
+            num_layers=len(self.layer_ids),
+            kv_heads=self.hf_config.num_key_value_heads,
+            query_heads=self.hf_config.num_attention_heads,
+            head_dim=self.head_dim,
+            hidden_size=self.hidden_size,
+        )["bytes"]
+
+    def load_draft_model(
+        self, target_model: torch.nn.Module, target_attn_layer_names: set[str]
+    ) -> torch.nn.Module:
+        from vllm.compilation.backends import set_model_tag
+        from vllm.model_executor.model_loader import get_model
+
+        draft_config = replace(
+            self.vllm_config,
+            load_config=get_pp_safe_draft_load_config(
+                get_draft_load_config(self.vllm_config)
+            ),
+        )
+        with set_model_tag("longspark_head"):
+            model = get_model(
+                vllm_config=draft_config, model_config=self.draft_model_config
+            )
+        self.state = LongSparkState(
+            model,
+            target_model,
+            self.hf_config,
+            max_num_reqs=2 * self.max_num_reqs,
+            device=self.device,
+        )
+        self._target_attention = [
+            target_model.model.layers[i].self_attn.attn for i in self.layer_ids
+        ]
+        shape = (
+            self.max_num_reqs,
+            len(self.layer_ids),
+            8,
+            self.hf_config.num_key_value_heads,
+            self.head_dim,
+        )
+        self._keys = torch.zeros(shape, dtype=self.dtype, device=self.device)
+        self._values = torch.zeros_like(self._keys)
+        self._hidden = torch.zeros(
+            self.max_num_reqs,
+            len(self.layer_ids),
+            self.hidden_size,
+            dtype=self.dtype,
+            device=self.device,
+        )
+        return model
+
+    def set_attn(
+        self,
+        model_state,
+        kv_cache_config,
+        block_tables,
+        target_input_buffers,
+        target_attn_groups,
+    ) -> None:
+        # LongSpark consumes target KV; it does not allocate another paged cache.
+        self.model_state = model_state
+        self.kv_cache_config = kv_cache_config
+        self.block_tables = block_tables
+        self.target_input_buffers = target_input_buffers
+        self.target_attn_groups = target_attn_groups
+        self.attn_groups = []
+
+    def init_cudagraph_manager(self, cudagraph_mode: CUDAGraphMode) -> None:
+        mode = (
+            CUDAGraphMode.FULL_DECODE_ONLY
+            if cudagraph_mode.decode_mode() == CUDAGraphMode.FULL
+            else CUDAGraphMode.NONE
+        )
+        self._graph_manager = CudaGraphManager(
+            self.vllm_config, self.device, mode, decode_query_len=7
+        )
+
+    @torch.inference_mode()
+    def _generate_draft(self, batch: int) -> None:
+        self.state.update(
+            self._idx[:batch],
+            self._keys[:batch],
+            self._values[:batch],
+            self._hidden[:batch],
+            self._starts[:batch],
+            self._counts[:batch],
+        )
+        self.draft_tokens[:batch].copy_(
+            self.state.propose(self._idx[:batch], self._anchors[:batch])
+        )
+
+    def capture(self) -> None:
+        assert self._graph_manager is not None
+        self._idx.copy_(self._padding_slots)
+        self._starts.fill_(1)
+        self._counts.zero_()
+        self._anchors.zero_()
+
+        def prepare(desc, warmup):
+            batch = desc.num_reqs or desc.num_tokens // 7
+            return lambda _mode: self._generate_draft(batch)
+
+        self._graph_manager.capture(prepare, "Capturing LongSpark CUDA graphs")
+
+    @torch.inference_mode()
+    def propose(
+        self,
+        input_batch: InputBatch,
+        attn_metadata: dict[str, Any],
+        slot_mappings: dict[str, torch.Tensor],
+        last_hidden_states: torch.Tensor,
+        aux_hidden_states: list[torch.Tensor] | None,
+        num_sampled: torch.Tensor,
+        num_rejected: torch.Tensor,
+        last_sampled: torch.Tensor,
+        next_prefill_tokens: torch.Tensor,
+        temperature: torch.Tensor,
+        seeds: torch.Tensor,
+        dp_sync_state: DPSyncState | None = None,
+        dummy_run: bool = False,
+        skip_attn_for_dummy_run: bool = False,
+        mm_inputs: tuple[list[torch.Tensor], torch.Tensor] | None = None,
+        is_profile: bool = False,
+        num_speculative_tokens: int | None = None,
+    ) -> torch.Tensor:
+        batch = input_batch.num_reqs
+        self._idx.copy_(self._padding_slots)
+        self._starts.fill_(1)
+        self._counts.zero_()
+        self._anchors.zero_()
+        if dummy_run or skip_attn_for_dummy_run:
+            # Profile the actual network together with its largest prefill
+            # workspace, before target KV has been allocated. Dummy slots do
+            # not overlap live request state.
+            scratch = None
+            if is_profile:
+                scratch = torch.empty(
+                    self._prefill_workspace_bytes, dtype=torch.uint8, device=self.device
+                )
+            self._generate_draft(batch)
+            del scratch
+            return self.draft_tokens[:batch]
+
+        idx = input_batch.idx_mapping.long()
+        # The width is scheduler-owned CPU metadata; accepted lengths remain
+        # on the GPU. Fixed decode widths write directly into graph buffers.
+        if int(input_batch.num_scheduled_tokens.max()) <= 8:
+            fused_gather_target_context(
+                self,
+                input_batch,
+                slot_mappings,
+                last_hidden_states,
+                aux_hidden_states,
+                num_rejected,
+                output_buffers=(
+                    self._keys[:batch],
+                    self._values[:batch],
+                    self._hidden[:batch],
+                    self._starts[:batch],
+                    self._counts[:batch],
+                ),
+            )
+        else:
+            keys, values, hidden, starts, counts, _ = gather_target_context(
+                self,
+                input_batch,
+                slot_mappings,
+                last_hidden_states,
+                aux_hidden_states,
+                num_rejected,
+            )
+            # Variable-width prefill ingestion precedes the fixed Local7 graph.
+            self.state.update(idx, keys, values, hidden, starts, counts)
+        self._idx[:batch].copy_(idx)
+        anchors = last_sampled.reshape(self.max_num_reqs, -1)[idx, 0]
+        # Partial-prefill drafts are discarded by the scheduler.
+        self._anchors[:batch].copy_(torch.where(num_sampled > 0, anchors, 0))
+
+        assert self._graph_manager is not None
+        desc = self._graph_manager.dispatch(
+            batch, batch * 7, uniform_token_count=7, num_active_loras=0
+        )
+        if desc.cg_mode == CUDAGraphMode.FULL and not is_profile:
+            self._graph_manager.run_fullgraph(desc)
+        else:
+            self._generate_draft(batch)
+        return self.draft_tokens[:batch]
