+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+
+import asyncio
+import json
+
+import openai
+import pytest
+
+from tests.evals.gsm8k.gsm8k_eval import _build_gsm8k_prompts, get_answer_value
+from tests.utils import RemoteOpenAIServer
+from tests.v1.e2e.spec_decode.utils import compute_acceptance_len
+from vllm import SamplingParams
+from vllm.config import CompilationConfig
+from vllm.platforms import current_platform
+
+MODEL = "Qwen/Qwen3-4B"
+DRAFT = "Hehy/LongSpark-Qwen3-4B"
+SPECULATIVE_CONFIG = {
+    "method": "longspark",
+    "model": DRAFT,
+    "num_speculative_tokens": 7,
+}
+ENV = {
+    "VLLM_USE_V2_MODEL_RUNNER": "1",
+    "VLLM_GPU_SYNC_CHECK": "error",
+    "VLLM_BATCH_INVARIANT": "1",
+    "VLLM_USE_FLASHINFER_SAMPLER": "0",
+}
+pytestmark = pytest.mark.skipif(
+    not current_platform.is_cuda(), reason="LongSpark requires CUDA"
+)
+
+
+@pytest.mark.parametrize("enforce_eager,num_questions", [(False, 100), (True, 4)])
+def test_longspark_matches_greedy_target_on_gsm8k(
+    vllm_runner, monkeypatch, enforce_eager, num_questions
+):
+    """Pin output tokens and real acceptance with chunked prefill/batching."""
+    for name, value in ENV.items():
+        monkeypatch.setenv(name, value)
+    prompts, labels = _build_gsm8k_prompts(num_questions, num_shots=0)
+    messages = [[{"role": "user", "content": prompt}] for prompt in prompts]
+    params = SamplingParams(temperature=0, max_tokens=1024)
+    options = dict(
+        dtype="bfloat16",
+        max_model_len=4096,
+        max_num_seqs=4,
+        max_num_batched_tokens=512,
+        kv_cache_memory_bytes=4 * 1024**3,
+        enable_prefix_caching=False,
+        enable_chunked_prefill=True,
+        async_scheduling=True,
+        enforce_eager=enforce_eager,
+        disable_log_stats=False,
+        compilation_config=CompilationConfig(cudagraph_mode="FULL_AND_PIECEWISE"),
+    )
+    with vllm_runner(MODEL, **options) as runner:
+        reference = runner.llm.chat(
+            messages, params, chat_template_kwargs={"enable_thinking": False}
+        )
+    with vllm_runner(MODEL, speculative_config=SPECULATIVE_CONFIG, **options) as runner:
+        outputs = runner.llm.chat(
+            messages, params, chat_template_kwargs={"enable_thinking": False}
+        )
+        acceptance_len = compute_acceptance_len(runner.llm.get_metrics())
+
+    assert len(outputs) == len(reference) == num_questions
+    for expected, actual in zip(reference, outputs):
+        assert actual.outputs[0].token_ids == expected.outputs[0].token_ids
+    accuracy = (
+        sum(
+            get_answer_value(output.outputs[0].text) == label
+            for output, label in zip(outputs, labels)
+        )
+        / num_questions
+    )
+    print(
+        f"LongSpark GSM8K: accuracy={accuracy:.3f}, acceptance_len={acceptance_len:.3f}"
+    )
+    assert acceptance_len > 1
+    if num_questions == 100:
+        assert accuracy >= 0.8
+
+
+@pytest.fixture(scope="module")
+def server():
+    args = [
+        "--dtype",
+        "bfloat16",
+        "--max-model-len",
+        "4096",
+        "--max-num-seqs",
+        "4",
+        "--max-num-batched-tokens",
+        "512",
+        "--kv-cache-memory-bytes",
+        str(4 * 1024**3),
+        "--no-enable-prefix-caching",
+        "--compilation-config",
+        '{"cudagraph_mode":"FULL_AND_PIECEWISE"}',
+        "--speculative-config",
+        json.dumps(SPECULATIVE_CONFIG),
+    ]
+    with RemoteOpenAIServer(MODEL, args, env_dict=ENV) as remote_server:
+        yield remote_server
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("chat", [False, True])
+async def test_native_api_streaming_concurrency_and_rejected_requests(server, chat):
+    """An invalid request must not poison subsequent native API generations."""
+    async with server.get_async_client() as client:
+        create = client.chat.completions.create if chat else client.completions.create
+        kwargs = dict(model=MODEL, temperature=0, max_tokens=32)
+        if chat:
+            kwargs.update(
+                messages=[{"role": "user", "content": "What is 12 + 15?"}],
+                extra_body={"chat_template_kwargs": {"enable_thinking": False}},
+            )
+        else:
+            kwargs["prompt"] = "The sum of twelve and fifteen is"
+        result = await create(**kwargs)
+        expected = result.choices[0].message.content if chat else result.choices[0].text
+        assert expected
+        stream = await create(**kwargs, stream=True)
+        chunks = []
+        async for chunk in stream:
+            if chunk.choices:
+                choice = chunk.choices[0]
+                chunks.append((choice.delta.content if chat else choice.text) or "")
+        assert "".join(chunks) == expected
+        for invalid in ({"temperature": 0.7}, {"presence_penalty": 0.5}):
+            with pytest.raises(openai.BadRequestError, match="LongSpark"):
+                await create(**(kwargs | invalid))
+        results = await asyncio.gather(*(create(**kwargs) for _ in range(4)))
+        assert all(
+            (r.choices[0].message.content if chat else r.choices[0].text) == expected
+            for r in results
+        )
