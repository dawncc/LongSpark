+++ b/vllm/config/longspark.py
@@ -0,0 +1,221 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+
+import math
+from typing import TYPE_CHECKING
+
+import torch
+
+from vllm.exceptions import VLLMValidationError
+
+if TYPE_CHECKING:
+    from vllm.config import SpeculativeConfig, VllmConfig
+    from vllm.sampling_params import SamplingParams
+
+
+def validate_longspark_speculative_config(config: "SpeculativeConfig") -> None:
+    """Validate the checkpoint/target contract before loading weights."""
+    draft = config.draft_model_config.hf_config
+    target = config.target_model_config.hf_text_config
+    if draft.model_type != "draftfreekv":
+        raise ValueError("LongSpark requires a draftfreekv checkpoint.")
+    if target.model_type != "qwen3":
+        raise ValueError("LongSpark currently supports dense Qwen3 targets only.")
+    if config.num_speculative_tokens != 7:
+        raise ValueError("LongSpark requires num_speculative_tokens=7.")
+    unsupported = []
+    for name in (
+        "enable_adaptive_verification",
+        "use_local_argmax_reduction",
+        "disable_padded_drafter_batch",
+        "num_speculative_tokens_per_batch_size",
+        "use_heterogeneous_vocab",
+        "quantization",
+    ):
+        if getattr(config, name):
+            unsupported.append(name)
+    if config.draft_sample_method != "greedy":
+        unsupported.append("non-greedy drafting")
+    if config.rejection_sample_method != "standard":
+        unsupported.append("non-standard rejection sampling")
+    if config.kv_cache_dtype not in (None, "auto"):
+        unsupported.append("quantized draft KV cache")
+    if unsupported:
+        raise ValueError("LongSpark does not support " + ", ".join(unsupported) + ".")
+
+    fixed = {
+        "draft_mode": "parallel_shifted_qwen",
+        "global16_raw256_enabled": True,
+        "block_size": 7,
+        "global_memory_slots": 16,
+        "raw_target_rows": 256,
+        "local_draft_rows": 7,
+        "max_accepted_tokens": 8,
+        "parallel_markov_head_type": "vanilla",
+    }
+    for name, expected in fixed.items():
+        if getattr(draft, name, None) != expected:
+            raise ValueError(f"LongSpark requires draft {name}={expected!r}.")
+    for name, expected in {
+        "target_kv_memory_layout": "direct",
+        "global_memory_source_window": "full",
+        "global_checkpoint_compatibility": "retrain_required",
+    }.items():
+        if getattr(draft, name, expected) != expected:
+            raise ValueError(f"LongSpark requires draft {name}={expected!r}.")
+    for name in (
+        "target_kv_window_size",
+        "memory_output_slots",
+        "memory_source_window",
+    ):
+        if getattr(draft, name, None) is not None:
+            raise ValueError(f"LongSpark does not support draft {name}.")
+    if draft.global_query_mode not in ("learned", "fixed_equicorrelated"):
+        raise ValueError("Unsupported LongSpark global_query_mode.")
+    if not -1 / 15 < draft.global_query_equicorrelation < 1:
+        raise ValueError(
+            "LongSpark global_query_equicorrelation must be in (-1/15, 1)."
+        )
+    if draft.global_query_slot_mass_mode not in ("system", "baseline16"):
+        raise ValueError("Unsupported LongSpark global_query_slot_mass_mode.")
+
+    layers = draft.target_layer_ids
+    if (
+        not layers
+        or any(
+            type(i) is not int or not 0 <= i < target.num_hidden_layers for i in layers
+        )
+        or sorted(set(layers)) != layers
+    ):
+        raise ValueError(
+            "LongSpark target_layer_ids must be unique, ascending target layers."
+        )
+    if draft.parallel_mixer_layers != len(layers):
+        raise ValueError(
+            "LongSpark requires one mixer layer per selected target layer."
+        )
+    aux_layers = [i + 1 for i in layers if i != target.num_hidden_layers - 1]
+    if not aux_layers:
+        raise ValueError("LongSpark requires at least one non-final target layer.")
+    draft.eagle_aux_hidden_state_layer_ids = aux_layers
+
+    target_head_dim = getattr(target, "head_dim", None) or (
+        target.hidden_size // target.num_attention_heads
+    )
+    for name, expected in {
+        "hidden_size": target.hidden_size,
+        "vocab_size": target.vocab_size,
+        "num_key_value_heads": target.num_key_value_heads,
+        "head_dim": target_head_dim,
+        "qwen_num_attention_heads": target.num_attention_heads,
+    }.items():
+        if getattr(draft, name) != expected:
+            raise ValueError(
+                f"LongSpark draft {name} must match the target ({expected})."
+            )
+    if (
+        not isinstance(draft.mask_token_id, int)
+        or not 0 <= draft.mask_token_id < draft.vocab_size
+    ):
+        raise ValueError(
+            "LongSpark mask_token_id must be inside the target vocabulary."
+        )
+    if draft.parallel_markov_rank < 0 or draft.qwen_intermediate_size <= 0:
+        raise ValueError("Invalid LongSpark draft dimensions.")
+    if draft.head_dim % 2 or draft.qwen_num_attention_heads % draft.num_key_value_heads:
+        raise ValueError(
+            "LongSpark requires even head_dim and integral grouped attention."
+        )
+    if getattr(target, "use_sliding_window", False):
+        raise ValueError("LongSpark requires full target attention.")
+    for rope in (
+        getattr(target, "rope_scaling", None),
+        getattr(target, "rope_parameters", None),
+    ):
+        if rope and (
+            not isinstance(rope, dict)
+            or rope.get("rope_type", rope.get("type", "default")) != "default"
+            or any(key in rope for key in ("factor", "long_factor", "short_factor"))
+        ):
+            raise ValueError("LongSpark requires native, unscaled target RoPE.")
+    rope = getattr(target, "rope_parameters", None) or {}
+    theta = rope.get("rope_theta", getattr(target, "rope_theta", 1_000_000.0))
+    if (
+        not math.isfinite(theta)
+        or theta <= 0
+        or not math.isclose(draft.qwen_rope_theta, theta, rel_tol=1e-9)
+    ):
+        raise ValueError("LongSpark draft RoPE theta must match the target.")
+
+
+def validate_longspark_config(config: "VllmConfig") -> None:
+    """Validate serving capabilities only for the LongSpark method."""
+    from vllm.platforms import current_platform
+    from vllm.v1.attention.backends.registry import AttentionBackendEnum
+
+    if not current_platform.is_cuda():
+        raise ValueError("LongSpark currently requires a CUDA device.")
+    if not config.use_v2_model_runner:
+        raise ValueError("LongSpark requires Model Runner V2.")
+    model = config.model_config
+    if (
+        model.model_impl not in ("auto", "vllm")
+        or model.runner_type != "generate"
+        or "Qwen3ForCausalLM" not in model.architectures
+    ):
+        raise ValueError("LongSpark requires vLLM's native Qwen3ForCausalLM generator.")
+    if model.dtype != torch.bfloat16 or model.quantization:
+        raise ValueError("LongSpark requires an unquantized BF16 target.")
+    if config.cache_config.cache_dtype != "auto":
+        raise ValueError("LongSpark requires unquantized BF16 target KV cache.")
+    if config.cache_config.enable_prefix_caching:
+        raise ValueError("LongSpark requires --no-enable-prefix-caching.")
+    for name in (
+        "tensor_parallel_size",
+        "pipeline_parallel_size",
+        "data_parallel_size",
+        "decode_context_parallel_size",
+        "prefill_context_parallel_size",
+    ):
+        if getattr(config.parallel_config, name) != 1:
+            raise ValueError("LongSpark currently requires TP=PP=DP=DCP=PCP=1.")
+    for name in ("lora_config", "kv_transfer_config", "watermark_config"):
+        if getattr(config, name, None) is not None:
+            raise ValueError(f"LongSpark does not support {name}.")
+    if model.logits_processors:
+        raise ValueError("LongSpark does not support custom logits processors.")
+    if config.attention_config.backend not in (None, AttentionBackendEnum.FLASH_ATTN):
+        raise ValueError("LongSpark currently requires the FlashAttention backend.")
+    config.attention_config.backend = AttentionBackendEnum.FLASH_ATTN
+
+
+def validate_longspark_sampling_params(params: "SamplingParams") -> None:
+    """Reject unsupported requests before dispatch to a GPU worker."""
+    defaults = {
+        "temperature": 0.0,
+        "presence_penalty": 0.0,
+        "frequency_penalty": 0.0,
+        "repetition_penalty": 1.0,
+    }
+    for name, expected in defaults.items():
+        if getattr(params, name) != expected:
+            raise VLLMValidationError(
+                f"LongSpark currently requires {name}={expected}.", parameter=name
+            )
+    for name in (
+        "structured_outputs",
+        "allowed_token_ids",
+        "bad_words",
+        "logits_processors",
+        "extra_args",
+        "watermarking",
+    ):
+        if getattr(params, name, None):
+            raise VLLMValidationError(
+                f"LongSpark currently does not support {name}.", parameter=name
+            )
+    if params.thinking_token_budget is not None:
+        raise VLLMValidationError(
+            "LongSpark currently does not support thinking_token_budget.",
+            parameter="thinking_token_budget",
+        )
