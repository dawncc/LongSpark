+"""LongSpark Global16/Raw256/Local7 draft, with the original checkpoint keys.
+
+Only the inference path is included. The ModelRunner V2 speculator supplies
+confirmed target context and shared target embedding, final norm and LM head.
+"""
+
+import math
+import weakref
+from collections.abc import Iterable
+from types import SimpleNamespace
+from typing import TYPE_CHECKING
+
+import torch
+from torch import nn
+from torch.nn import functional as F
+
+if TYPE_CHECKING:
+    from vllm.config import VllmConfig
+
+
+class _RMSNorm(nn.Module):
+    def __init__(self, hidden_size: int, eps: float = 1e-6):
+        super().__init__()
+        self.weight = nn.Parameter(torch.ones(hidden_size))
+        self.eps = eps
+
+    def forward(self, hidden_states: torch.Tensor) -> torch.Tensor:
+        variance = hidden_states.float().pow(2).mean(dim=-1, keepdim=True)
+        normalized = hidden_states.float() * torch.rsqrt(variance + self.eps)
+        return normalized.to(hidden_states.dtype) * self.weight.to(hidden_states.dtype)
+
+
+class _FeedForward(nn.Module):
+    def __init__(self, in_features: int, hidden_size: int):
+        super().__init__()
+        self.net = nn.Sequential(
+            nn.Linear(in_features, hidden_size, bias=False),
+            nn.SiLU(),
+            nn.Linear(hidden_size, hidden_size, bias=False),
+        )
+
+    def forward(self, hidden_states: torch.Tensor) -> torch.Tensor:
+        return self.net(hidden_states)
+
+
+class _DraftStateEncoder(nn.Module):
+    def __init__(self, num_layers: int, hidden_size: int):
+        super().__init__()
+        self.proj = _FeedForward(num_layers * hidden_size, hidden_size)
+        self.norm = _RMSNorm(hidden_size)
+
+    def forward(self, selected_layer_hidden: torch.Tensor) -> torch.Tensor:
+        return self.norm(self.proj(selected_layer_hidden.flatten(start_dim=1)))
+
+
+class _ParallelShiftedInput(nn.Module):
+    def __init__(self, hidden_size: int, block_size: int, mask_token_id: int):
+        super().__init__()
+        self.block_size = block_size
+        self.mask_token_id = mask_token_id
+        self.position_embedding = nn.Embedding(block_size, hidden_size)
+        self.proj = _FeedForward(2 * hidden_size, hidden_size)
+        self.norm = _RMSNorm(hidden_size)
+
+    def forward(
+        self,
+        current_token_ids: torch.Tensor,
+        latest_target_state: torch.Tensor,
+        target_embed_tokens: nn.Module,
+    ) -> torch.Tensor:
+        token_ids = torch.full(
+            (current_token_ids.shape[0], self.block_size),
+            self.mask_token_id,
+            dtype=torch.long,
+            device=latest_target_state.device,
+        )
+        token_ids[:, 0] = current_token_ids.long()
+        token_states = target_embed_tokens(token_ids).to(latest_target_state.dtype)
+        positions = torch.arange(self.block_size, device=latest_target_state.device)
+        token_states = (
+            token_states
+            + self.position_embedding(positions).to(latest_target_state.dtype)[
+                None, :, :
+            ]
+        )
+        latest = latest_target_state[:, None, :].expand(-1, self.block_size, -1)
+        return self.norm(self.proj(torch.cat([token_states, latest], dim=-1)))
+
+
+class _LongSparkAttention(nn.Module):
+    def __init__(self, config):
+        super().__init__()
+        self.num_attention_heads = config.qwen_num_attention_heads
+        self.num_key_value_heads = config.num_key_value_heads
+        self.head_dim = config.head_dim
+        self.q_proj = nn.Linear(
+            config.hidden_size, self.num_attention_heads * self.head_dim, bias=False
+        )
+        self.k_proj = nn.Linear(
+            config.hidden_size, self.num_key_value_heads * self.head_dim, bias=False
+        )
+        self.v_proj = nn.Linear(
+            config.hidden_size, self.num_key_value_heads * self.head_dim, bias=False
+        )
+        self.o_proj = nn.Linear(
+            self.num_attention_heads * self.head_dim, config.hidden_size, bias=False
+        )
+        self.q_norm = _RMSNorm(self.head_dim, config.qwen_rms_norm_eps)
+        self.k_norm = _RMSNorm(self.head_dim, config.qwen_rms_norm_eps)
+        inv_freq = 1.0 / (
+            config.qwen_rope_theta
+            ** (torch.arange(0, self.head_dim, 2, dtype=torch.float32) / self.head_dim)
+        )
+        self.register_buffer("inv_freq", inv_freq, persistent=False)
+
+    def forward(
+        self,
+        hidden_states: torch.Tensor,
+        position_ids: torch.Tensor,
+        context,
+        layer_index: int,
+    ) -> torch.Tensor:
+        batch, block_size, _ = hidden_states.shape
+        query = self.q_proj(hidden_states).view(
+            batch, block_size, self.num_attention_heads, self.head_dim
+        )
+        keys = self.k_proj(hidden_states).view(
+            batch, block_size, self.num_key_value_heads, self.head_dim
+        )
+        values = self.v_proj(hidden_states).view(
+            batch, block_size, self.num_key_value_heads, self.head_dim
+        )
+        query = self.q_norm(query).transpose(1, 2)
+        keys = self.k_norm(keys).transpose(1, 2)
+        values = values.transpose(1, 2)
+        frequencies = (
+            position_ids.to(device=self.inv_freq.device, dtype=torch.float32)[..., None]
+            * self.inv_freq[None, None, :]
+        )
+        embeddings = torch.cat([frequencies, frequencies], dim=-1)
+        cos = embeddings.cos().to(query.dtype)[:, None, :, :]
+        sin = embeddings.sin().to(query.dtype)[:, None, :, :]
+
+        def rotate_half(tensor):
+            first, second = tensor.chunk(2, dim=-1)
+            return torch.cat((-second, first), dim=-1)
+
+        query = query * cos + rotate_half(query) * sin
+        keys = keys * cos + rotate_half(keys) * sin
+        local_mask = torch.ones(
+            (batch, block_size, block_size),
+            dtype=torch.bool,
+            device=hidden_states.device,
+        )
+        attended = context.attend(
+            layer_index=layer_index,
+            query=query,
+            local_keys=keys,
+            local_values=values,
+            local_attention_mask=local_mask,
+        )
+        attended = (
+            attended.transpose(1, 2)
+            .contiguous()
+            .view(batch, block_size, self.num_attention_heads * self.head_dim)
+        )
+        return self.o_proj(attended)
+
+
+class _SwiGLUMLP(nn.Module):
+    def __init__(self, hidden_size: int, intermediate_size: int):
+        super().__init__()
+        self.gate_proj = nn.Linear(hidden_size, intermediate_size, bias=False)
+        self.up_proj = nn.Linear(hidden_size, intermediate_size, bias=False)
+        self.down_proj = nn.Linear(intermediate_size, hidden_size, bias=False)
+
+    def forward(self, hidden_states: torch.Tensor) -> torch.Tensor:
+        return self.down_proj(
+            F.silu(self.gate_proj(hidden_states)) * self.up_proj(hidden_states)
+        )
+
+
+class _LongSparkDecoderLayer(nn.Module):
+    def __init__(self, config):
+        super().__init__()
+        self.self_attn = _LongSparkAttention(config)
+        self.mlp = _SwiGLUMLP(config.hidden_size, config.qwen_intermediate_size)
+        self.input_layernorm = _RMSNorm(config.hidden_size, config.qwen_rms_norm_eps)
+        self.post_attention_layernorm = _RMSNorm(
+            config.hidden_size, config.qwen_rms_norm_eps
+        )
+
+    def forward(self, hidden_states, position_ids, context, layer_index):
+        residual = hidden_states
+        hidden_states = self.self_attn(
+            self.input_layernorm(hidden_states), position_ids, context, layer_index
+        )
+        hidden_states = residual + hidden_states
+        return hidden_states + self.mlp(self.post_attention_layernorm(hidden_states))
+
+
+class _MarkovHead(nn.Module):
+    def __init__(self, vocab_size: int, markov_rank: int):
+        super().__init__()
+        self.markov_w1 = nn.Embedding(vocab_size, markov_rank)
+        self.markov_w2 = nn.Linear(markov_rank, vocab_size, bias=False)
+
+    def compute_bias(self, previous_token_ids: torch.Tensor) -> torch.Tensor:
+        return self.markov_w2(self.markov_w1(previous_token_ids.long()))
+
+
+class _GlobalQueryGenerator(nn.Module):
+    def __init__(self, config):
+        super().__init__()
+        self.learned_query = nn.Parameter(
+            torch.empty(
+                len(config.target_layer_ids),
+                config.qwen_num_attention_heads,
+                config.global_memory_slots,
+                config.head_dim,
+            ),
+            requires_grad=False,
+        )
+
+
+class _GlobalReference(nn.Module):
+    def __init__(self, config):
+        super().__init__()
+        self.config = SimpleNamespace(
+            num_attention_heads=config.qwen_num_attention_heads,
+            global_memory_slots=config.global_memory_slots,
+            raw_target_rows=config.raw_target_rows,
+            local_draft_rows=config.local_draft_rows,
+            max_accepted_tokens=config.max_accepted_tokens,
+        )
+        self.global_query_generator = _GlobalQueryGenerator(config)
+
+    def global_queries(self, *, batch_size, device, dtype):
+        return (
+            self.global_query_generator.learned_query[None]
+            .expand(batch_size, -1, -1, -1, -1)
+            .to(device=device, dtype=dtype)
+        )
+
+
+class LongSparkDraftModel(nn.Module):
+    """Inference-only draft loaded by the standard vLLM checkpoint loader."""
+
+    def __init__(self, *, vllm_config: "VllmConfig", prefix: str = ""):
+        super().__init__()
+        del prefix  # Plain torch layers do not register vLLM attention operators.
+        speculative_config = vllm_config.speculative_config
+        if speculative_config is None or speculative_config.method != "longspark":
+            raise ValueError("LongSparkDraftModel requires method='longspark'")
+        self.config = config = speculative_config.draft_model_config.hf_config
+        if (
+            config.draft_mode != "parallel_shifted_qwen"
+            or not config.global16_raw256_enabled
+            or config.block_size != 7
+            or config.parallel_mixer_layers != len(config.target_layer_ids)
+        ):
+            raise ValueError("LongSpark requires a Global16/Raw256/Local7 checkpoint")
+        self.num_layers = len(config.target_layer_ids)
+        self.draft_state_encoder = _DraftStateEncoder(
+            self.num_layers, config.hidden_size
+        )
+        self.parallel_shifted_input = _ParallelShiftedInput(
+            config.hidden_size, config.block_size, config.mask_token_id
+        )
+        self.parallel_qwen_layers = nn.ModuleList(
+            _LongSparkDecoderLayer(config) for _ in range(self.num_layers)
+        )
+        self.parallel_markov_head = (
+            _MarkovHead(config.vocab_size, config.parallel_markov_rank)
+            if config.parallel_markov_rank > 0
+            else None
+        )
+        self.global16_raw256_reference = _GlobalReference(config)
+        self._target_embedding: weakref.ReferenceType[nn.Module] | None = None
+
+    def bind_target_embedding(self, embedding: nn.Module) -> None:
+        self._target_embedding = weakref.ref(embedding)
+
+    def embed_input_ids(self, input_ids: torch.Tensor) -> torch.Tensor:
+        embedding = self._target_embedding() if self._target_embedding else None
+        if embedding is None:
+            raise RuntimeError("LongSpark target embedding has not been bound")
+        return embedding(input_ids)
+
+    def forward(
+        self,
+        input_ids: torch.Tensor | None = None,
+        positions: torch.Tensor | None = None,
+        *,
+        current_hidden_states: torch.Tensor,
+        current_token_ids: torch.Tensor | None = None,
+        current_position_ids: torch.Tensor | None = None,
+        target_final_norm: nn.Module,
+        target_embed_tokens: nn.Module,
+        target_lm_head: nn.Module,
+        global16_paged_context,
+        apply_markov_correction: bool = False,
+    ) -> torch.Tensor:
+        if apply_markov_correction:
+            raise ValueError("The speculator applies sequential Markov correction")
+        if current_token_ids is None:
+            current_token_ids = input_ids
+        if current_position_ids is None:
+            current_position_ids = positions
+        if current_token_ids is None or current_position_ids is None:
+            raise ValueError("LongSpark requires input tokens and their positions")
+        latest = self.draft_state_encoder(current_hidden_states)
+        hidden = self.parallel_shifted_input(
+            current_token_ids, latest, target_embed_tokens
+        )
+        positions = (
+            current_position_ids[:, None]
+            + torch.arange(
+                self.config.block_size,
+                dtype=torch.long,
+                device=current_position_ids.device,
+            )[None, :]
+        )
+        for layer_index, layer in enumerate(self.parallel_qwen_layers):
+            hidden = layer(hidden, positions, global16_paged_context, layer_index)
+        # Match the checkpoint implementation's flattened target RMSNorm and
+        # BF16 vocabulary contraction before promoting logits to FP32.
+        shape = hidden.shape
+        norm_weight = target_final_norm.weight
+        hidden = (
+            F.rms_norm(
+                hidden.reshape(-1, shape[-1]).to(norm_weight.dtype),
+                (shape[-1],),
+                norm_weight,
+                target_final_norm.variance_epsilon,
+            )
+            .reshape(shape)
+            .to(hidden.dtype)
+        )
+        return F.linear(
+            hidden.to(target_lm_head.weight.dtype), target_lm_head.weight
+        ).float()
+
+    def compute_logits(self, logits: torch.Tensor) -> torch.Tensor:
+        """Forward already applies the shared target norm and vocabulary head."""
+        return logits
+
+    def load_weights(self, weights: Iterable[tuple[str, torch.Tensor]]) -> set[str]:
+        from vllm.model_executor.model_loader.weight_utils import default_weight_loader
+
+        parameters = dict(self.named_parameters())
+        loaded: set[str] = set()
+        for name, weight in weights:
+            if name not in parameters:
+                raise ValueError(f"Unexpected LongSpark checkpoint weight: {name}")
+            if name in loaded:
+                raise ValueError(f"Duplicate LongSpark checkpoint weight: {name}")
+            default_weight_loader(parameters[name], weight)
+            loaded.add(name)
+        missing = parameters.keys() - loaded
+        if missing:
+            raise ValueError(f"Missing LongSpark checkpoint weights: {sorted(missing)}")
+        if self.config.global_query_mode == "fixed_equicorrelated":
+            self._validate_fixed_queries()
+        return loaded
+
+    def _validate_fixed_queries(self) -> None:
+        generator = self.global16_raw256_reference.global_query_generator
+        query = generator.learned_query.detach().float()
+        norms = query.norm(dim=-1, keepdim=True)
+        if bool(torch.any(norms <= torch.finfo(query.dtype).eps).item()):
+            raise ValueError("Fixed LongSpark query checkpoint contains a zero row")
+        normalized = query / norms
+        gram = torch.einsum("lhsd,lhtd->lhst", normalized, normalized)
+        slots = self.config.global_memory_slots
+        correlation = self.config.global_query_equicorrelation
+        expected = (1.0 - correlation) * torch.eye(
+            slots, device=gram.device
+        ) + correlation * torch.ones((slots, slots), device=gram.device)
+        error = float((gram - expected).abs().max().item())
+        if not math.isfinite(error) or error > 5e-3:
+            raise ValueError("Fixed LongSpark query checkpoint has invalid geometry")
