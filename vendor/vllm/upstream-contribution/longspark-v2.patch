@@ -0,0 +1,165 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""LongSpark checkpoint integrity and independent dense-attention oracle.
+
+The loader must never silently initialize missing draft weights. CPU tests are
+sufficient for this contract; kernel and end-to-end tests cover GPU execution.
+"""
+
+from types import SimpleNamespace
+
+import pytest
+import torch
+from torch.nn import functional as F
+
+from vllm.model_executor.models.longspark import LongSparkDraftModel
+from vllm.v1.worker.gpu.spec_decode.longspark.attention import (
+    attention_statistics_from_4d,
+    merge_normalized_attention,
+)
+
+
+def make_model():
+    config = SimpleNamespace(
+        draft_mode="parallel_shifted_qwen",
+        global16_raw256_enabled=True,
+        target_layer_ids=[0, 2],
+        block_size=7,
+        parallel_mixer_layers=2,
+        hidden_size=16,
+        vocab_size=32,
+        qwen_num_attention_heads=2,
+        num_key_value_heads=1,
+        head_dim=8,
+        qwen_intermediate_size=32,
+        qwen_rms_norm_eps=1e-6,
+        qwen_rope_theta=1_000_000.0,
+        mask_token_id=0,
+        parallel_markov_rank=4,
+        global_memory_slots=16,
+        raw_target_rows=256,
+        local_draft_rows=7,
+        max_accepted_tokens=8,
+        global_query_mode="learned",
+        global_query_equicorrelation=0.4,
+    )
+    vllm_config = SimpleNamespace(
+        speculative_config=SimpleNamespace(
+            method="longspark", draft_model_config=SimpleNamespace(hf_config=config)
+        )
+    )
+    return LongSparkDraftModel(vllm_config=vllm_config)
+
+
+@pytest.fixture
+def model():
+    return make_model()
+
+
+def checkpoint_weights(model):
+    generator = torch.Generator().manual_seed(17)
+    return {
+        name: torch.randn(weight.shape, generator=generator)
+        for name, weight in model.named_parameters()
+    }
+
+
+def test_original_checkpoint_keys_load_without_target_weights(model):
+    weights = checkpoint_weights(model)
+    assert "global16_raw256_reference.global_query_generator.learned_query" in weights
+    assert "parallel_qwen_layers.1.self_attn.q_norm.weight" in weights
+    assert "parallel_markov_head.markov_w2.weight" in weights
+    assert not any("embed_tokens" in name or "lm_head" in name for name in weights)
+    loaded = model.load_weights(iter(weights.items()))
+    assert loaded == weights.keys()
+    for name, parameter in model.named_parameters():
+        torch.testing.assert_close(parameter, weights[name], rtol=0, atol=0)
+
+
+def test_embedding_protocol_shares_target_weights_without_checkpoint_parameters(model):
+    checkpoint_keys = set(dict(model.named_parameters()))
+    embedding = torch.nn.Embedding(32, 16)
+    model.bind_target_embedding(embedding)
+    token_ids = torch.tensor([2, 3])
+    torch.testing.assert_close(model.embed_input_ids(token_ids), embedding(token_ids))
+    assert set(dict(model.named_parameters())) == checkpoint_keys
+
+
+@pytest.mark.parametrize("corruption", ["missing", "unexpected", "duplicate", "shape"])
+def test_checkpoint_corruption_fails_before_inference(model, corruption):
+    weights = list(checkpoint_weights(model).items())
+    if corruption == "missing":
+        weights = [item for item in weights if "learned_query" not in item[0]]
+        error, match = ValueError, "Missing LongSpark checkpoint weights"
+    elif corruption == "unexpected":
+        weights.append(("target_lm_head.weight", torch.zeros(32, 16)))
+        error, match = ValueError, "Unexpected LongSpark checkpoint weight"
+    elif corruption == "duplicate":
+        weights.append(weights[0])
+        error, match = ValueError, "Duplicate LongSpark checkpoint weight"
+    else:
+        weights[0] = (weights[0][0], torch.zeros(1))
+        error, match = AssertionError, None
+    with pytest.raises(error, match=match):
+        model.load_weights(iter(weights))
+
+
+@pytest.mark.parametrize("fill", [0.0, 1.0, float("nan")])
+def test_fixed_query_geometry_is_checked_after_loading(model, fill):
+    model.config.global_query_mode = "fixed_equicorrelated"
+    weights = checkpoint_weights(model)
+    weights["global16_raw256_reference.global_query_generator.learned_query"].fill_(
+        fill
+    )
+    with pytest.raises(ValueError, match="Fixed LongSpark query checkpoint"):
+        model.load_weights(weights.items())
+
+
+@pytest.mark.parametrize("empty_first_source", [False, True])
+def test_source_wise_attention_matches_dense_gqa(empty_first_source):
+    """Global/raw/local merging must equal one dense masked softmax."""
+    generator = torch.Generator().manual_seed(23)
+    query = torch.randn(2, 4, 7, 8, generator=generator, dtype=torch.float64)
+    keys = torch.randn(2, 2, 30, 8, generator=generator, dtype=torch.float64)
+    values = torch.randn(2, 2, 30, 8, generator=generator, dtype=torch.float64)
+    mask = torch.rand(2, 7, 30, generator=generator) > 0.25
+    if empty_first_source:
+        mask[:, :, :16] = False
+    parts = []
+    for start, end in ((0, 16), (16, 23), (23, 30)):
+        stats = attention_statistics_from_4d(
+            query=query,
+            keys=keys[:, :, start:end],
+            values=values[:, :, start:end],
+            attention_mask=mask[:, :, start:end],
+        )
+        lse = (
+            stats.max_logits
+            + stats.normalizer.clamp_min(torch.finfo(torch.float64).tiny).log()
+        )
+        parts.append(
+            (stats.output(), lse.masked_fill(stats.normalizer == 0, -torch.inf))
+        )
+    output, _ = merge_normalized_attention(parts)
+    expected = F.scaled_dot_product_attention(
+        query,
+        keys.repeat_interleave(2, dim=1),
+        values.repeat_interleave(2, dim=1),
+        attn_mask=mask[:, None],
+    )
+    torch.testing.assert_close(output, expected, rtol=1e-12, atol=1e-12)
+
+
+def test_all_masked_attention_is_zero_and_has_negative_infinite_lse():
+    query = torch.ones(1, 2, 7, 8)
+    keys = torch.ones(1, 1, 16, 8)
+    stats = attention_statistics_from_4d(
+        query=query,
+        keys=keys,
+        values=keys,
+        attention_mask=torch.zeros(1, 7, 16, dtype=torch.bool),
+    )
+    part = (stats.output(), torch.full_like(stats.normalizer, -torch.inf))
+    output, lse = merge_normalized_attention((part, part))
+    assert torch.equal(output, torch.zeros_like(output))
+    assert torch.isneginf(lse).all()
